#cloud-config
autoinstall:
  version: 1
  # dont fetch/update the installer. So we can install without internet access.
  # We can do cloud-init updates later - see package_up[dat|grad]e below
  update: no
  keyboard: { layout: de, toggle: null, variant: "" }
  locale: de_DE.UTF-8

  ssh:
    allow-pw: true
    install-server: true

  network:
    version: 2
    ethernets:
      all-eths:
        match:
          name: "en*"
        dhcp4: true
        dhcp6: true
        # Do not block the install waiting for a lease on a NIC that may have no
        # cable. Without this, every matched en* interface is treated as
        # required and the installer stalls on network-online.
        optional: true
        dhcp4-overrides:
          use-hostname: true  # accept hostname pushed by router's DHCP

  storage:
    layout:
      name: direct  # install to the first (only) available disk

  late-commands:
    # Set MAC-based hostname before first boot so the router sees it on the first DHCP request
    - |
      # Pick the NIC whose MAC the router will actually see, in priority order:
      #   1. has an IPv4 address (it got a DHCP lease -> guaranteed match)
      #   2. has carrier (cable plugged in)
      #   3. lexicographically first physical NIC (no cable anywhere; still
      #      yields a usable, if arbitrary, hostname)
      # Only real devices are considered: /sys/class/net/*/device exists just for
      # physical (PCI/USB) NICs, which filters out bridges, bonds, veth, docker0.
      pick_iface() {
        cands=""
        for i in /sys/class/net/*; do
          i=$(basename "$i")
          case "$i" in en*|eth*) ;; *) continue ;; esac
          [ -e "/sys/class/net/$i/device" ] || continue
          cands="$cands $i"
        done
        # 1. carries an IPv4 address
        for i in $cands; do
          if ip -4 -o addr show dev "$i" scope global 2>/dev/null | grep -q inet; then
            echo "$i"; return 0
          fi
        done
        # 2. link up
        for i in $cands; do
          if [ "$(cat "/sys/class/net/$i/carrier" 2>/dev/null)" = "1" ]; then
            echo "$i"; return 0
          fi
        done
        # 3. first physical NIC
        for i in $cands; do echo "$i"; return 0; done
        return 1
      }

      iface=$(pick_iface)
      if [ -z "$iface" ]; then
        echo "late-commands: no physical ethernet NIC found, leaving hostname unchanged" >&2
        exit 0
      fi
      mac=$(tr -d ':' < "/sys/class/net/$iface/address")
      if [ -z "$mac" ]; then
        echo "late-commands: could not read MAC of $iface, leaving hostname unchanged" >&2
        exit 0
      fi
      echo "late-commands: using $iface (mac $mac) for hostname"
      hostname="ubuntu-autoinstall-$mac"
      echo "$hostname" > /target/etc/hostname
      sed -i '/^127\.0\.1\.1/d' /target/etc/hosts
      printf '127.0.1.1\t%s\n' "$hostname" >> /target/etc/hosts

  user-data:  # cloud-init runs after first reboot
    timezone: Europe/Berlin
    disable_root: false
    users:
      - name: trecs
        gecos: trecs developer
        groups: users, admin, docker, sudo
        sudo: "ALL=(ALL) NOPASSWD:ALL"
        shell: /bin/bash
        # password hash created using: openssl passwd -6 YOUR_PASSWORD
        passwd: "$6$wZbZSrDA1OWzPZ7t$qQcjn2sIw1yY8PmluT5dfocYBszOWLrqwXsLXLvrQCJ7umaCGVP5S.lWdGGzQY.lEKbGweGiAZHBjazZGy4S9."
        lock_passwd: false
        ssh_authorized_keys:
          - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIDSH6TV6Cg0FkJFw3ModUCRQcd9J+QZ5bN3Z8xM2/mti ssh-recs-testbed

      - name: cape
        gecos: CAPE developer
        groups: users, admin, docker, sudo
        sudo: "ALL=(ALL) NOPASSWD:ALL"
        shell: /bin/bash
        ssh_authorized_keys:
          - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAICiqA1P6lJCO4oGdOPI6ZEcbfJXxy8+QAAkxNhScIMYa ssh-trecs-gateway-cape-fwd
        # password hash created using: openssl passwd -6 YOUR_PASSWORD
        passwd: "$6$3EtT/sCyINKkNHsN$myguES8hypTyxKxfe4GEZMDcq.6orAauiAmAxElNgXSDzXFenXyzW2U3TOYfPofXvLCp8lzV0keJCdzbwWDZY."
        lock_passwd: false

    write_files:
      - path: /usr/local/bin/dhcp-hostname-refresh.sh
        permissions: "0755"
        content: |
          #!/bin/bash
          for iface in $(networkctl list --no-legend | awk '$3=="ether" && $4=="routable" {print $2}'); do
            ifindex=$(cat /sys/class/net/$iface/ifindex 2>/dev/null)
            lease_file="/run/systemd/netif/leases/$ifindex"
            if [[ -f "$lease_file" ]]; then
              dhcp_hostname=$(grep '^HOSTNAME=' "$lease_file" | cut -d= -f2)
              if [[ -n "$dhcp_hostname" ]]; then
                echo "Setting hostname to '$dhcp_hostname' (from DHCP lease on $iface)"
                hostnamectl set-hostname "$dhcp_hostname"
                break
              else
                echo "No DHCP hostname in lease for $iface, skipping"
              fi
            fi
          done

      - path: /etc/systemd/system/dhcp-hostname-refresh.service
        permissions: "0644"
        content: |
          [Unit]
          Description=Re-apply DHCP hostname (option 12) after boot
          After=network-online.target systemd-hostnamed.service
          Wants=network-online.target

          [Service]
          Type=oneshot
          ExecStart=/usr/local/bin/dhcp-hostname-refresh.sh
          RemainAfterExit=yes

          [Install]
          WantedBy=multi-user.target

    runcmd:
      - systemctl daemon-reload
      - systemctl enable dhcp-hostname-refresh.service
      # install RECSDaemon from source
      # - cd /tmp && git clone https://github.com/christmann/RECSDaemon.git && cd RECSDaemon && mkdir build && cd build && cmake .. && make install
      # - systemctl daemon-reload
      # - systemctl enable RECSDaemon.service
      # - systemctl start RECSDaemon.service

    packages:
      # build toolchain for RECSDaemon
      - build-essential
      - libssl-dev
      - pkg-config
      - cmake
      - git
      # runtime
      - docker.io
      - python3-pip

    package_update: true
    package_upgrade: true
